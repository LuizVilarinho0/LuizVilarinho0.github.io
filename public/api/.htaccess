# ---- API do site ----
Options -Indexes

# Arquivos que nunca devem ser servidos
<FilesMatch "^(config(\.local|\.local\.exemplo)?\.php|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Bloqueia as pastas internas mesmo se o .htaccess delas for apagado
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|private|storage|vendor)(/|$) - [F,L]
</IfModule>
